{
  "name": "@krelborn/markdown-review",
  "version": "0.1.0",
  "description": "Review agent-written markdown in the browser and hand the comments back to the agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krelborn/markdown-review.git"
  },
  "bin": {
    "markdown-review": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "@krelborn:registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.web.config.mts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:coverage": "pnpm test --coverage",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "prepare": "husky",
    "prepublishOnly": "pnpm build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@mdit/plugin-tasklist": "^1.1.3",
    "approx-string-match": "^2.0.0",
    "chokidar": "^5.0.0",
    "hono": "^4.13.13",
    "markdown-it": "^15.0.2",
    "open": "^11.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@krelborn/stylesui": "^0.2.1",
    "@playwright/test": "^1.64.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "fallow": "^3.32.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "mermaid": "^12.1.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.18.3"
}
